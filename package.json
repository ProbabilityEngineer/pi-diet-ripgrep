{
  "name": "pi-diet-ripgrep",
  "version": "0.1.5",
  "description": "Minimal Pi extension exposing ripgrep as a first-class exact-search tool.",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "lint": "tsc --noEmit",
    "build": "tsc --project tsconfig.build.json",
    "test": "tsx --test tests/*.test.ts"
  },
  "files": [
    "index.ts",
    "README.md",
    "spec.md"
  ],
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "ripgrep",
    "rg",
    "search"
  ],
  "author": "ProbabilityEngineer",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ProbabilityEngineer/pi-diet-ripgrep.git"
  },
  "bugs": {
    "url": "https://github.com/ProbabilityEngineer/pi-diet-ripgrep/issues"
  },
  "homepage": "https://github.com/ProbabilityEngineer/pi-diet-ripgrep#readme",
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^1.4.0",
    "@earendil-works/pi-coding-agent": "^1.4.0",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
